PORT=3000
# Optional shared API key for private API access. Public market data is open when unset.
API_KEY=
# Comma-separated browser origins; when API_KEY is configured, CORS defaults to disabled.
ALLOWED_ORIGINS=
# Optional OpenAI-compatible market commentary. Requires API_KEY as well.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
