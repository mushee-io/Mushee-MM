PORT=3000
STREAM_PORT=3001

# Legacy shared API key (development only); leave empty for a PUBLIC sandbox.
# When DATABASE_URL is configured, tenant-scoped DB keys replace this shared key.
API_KEY=
ALLOWED_ORIGINS=

# PostgreSQL; enables tenant-scoped API keys, atomic quotas and tick history.
# Run npm run migrate to create schema before starting the collector.
DATABASE_URL=
DB_POOL_MAX=5

# Optional model commentary. AI calls require API_KEY in this MVP.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# OPTIONAL: an already-licensed institutional vendor gateway implementing /quote.
# No equities, FX, commodities, bonds, derivatives or RWA quotes are enabled by default.
LICENSED_PROVIDER_BASE_URL=
LICENSED_PROVIDER_TOKEN=
LICENSED_ASSET_CATALOG=

# OPTIONAL: independently operated oracle publisher
PUBLISHER_ID=
PUBLISHER_PRIVATE_KEY_FILE=
PUBLISHER_API_KEY=
PUBLISHER_SOURCE=
ORACLE_SUBMIT_ENDPOINT=
PUBLISHER_MARKETS=BTC-USD,ETH-USD,SOL-USD
PUBLISHER_INTERVAL_MS=5000

# Internal contract pricing is always configured per tenant by an operator.
# Only price previews and unissued draft invoices are implemented.
# No processor credentials, taxes or payment collection are present.
